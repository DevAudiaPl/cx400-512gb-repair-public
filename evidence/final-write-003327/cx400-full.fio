[global]
filename=/dev/sdb
ioengine=libaio
iodepth=16
direct=1
numjobs=1
loops=1
allow_file_create=0
allow_mounted_write=0
rw=write
verify=pattern
verify_interval=4096
verify_pattern=0x4501af406dd887f3eef3becca4e13f66
verify_fatal=1
verify_dump=0
verify_state_save=0
verify_header_seed=0
verify_write_sequence=0
do_verify=0
end_fsync=1

[cx400-bulk]
offset=0
size=512109838336
bs=1048576

[cx400-tail]
offset=512109838336
size=352256
bs=4096
stonewall=1
